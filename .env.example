# LLM_PROVIDER: auto, groq, or ollama
# auto chooses Groq when GROQ_API_KEY is set; otherwise it tries Ollama.
LLM_PROVIDER=auto

# Option A: Groq free tier (recommended for the evaluator)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Option B: local Ollama (zero-cost, no API key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# If the LLM is temporarily unavailable, common analytics questions still work.
# The API clearly reports used_llm=false in this case.
ALLOW_HEURISTIC_FALLBACK=true
LLM_TIMEOUT_SECONDS=30

# Optional overrides
# DATA_PATH=data/support_tickets.csv
# HOST=127.0.0.1
# PORT=8000
